# OpenAI — diagnóstico y semántica
OPENAI_API_KEY=

# Vercel → Storage → Blob (store PRIVADO: perfiles JSON + casos humanos)
BLOB_READ_WRITE_TOKEN=

# Segundo store Blob PÚBLICO solo para fotos de perfil/portada (crear en Vercel → Storage → Blob → Public)
BLOB_READ_WRITE_TOKEN_PUBLIC=
# Activar cuando conectes el store público (obligatorio para subida desde el celu):
NEXT_PUBLIC_VU_PROFILE_MEDIA_PUBLIC=1

# Forzar almacén durable también en desarrollo local (opcional)
# VOCATIONUP_REQUIRE_DURABLE_CASES=1

# Juez de Coherencia Narrativa — ACTIVO por defecto en /api/analyze (mismo criterio que lab)
# Desactivar: NARRATIVE_COHERENCE_JUDGE_ENABLED=false
# Palancas en sentencia (corePattern, summary): ACTIVAS por defecto
# Desactivar solo palancas: NARRATIVE_COHERENCE_LEVERS_ENABLED=false

# Juez de Descarte — ACTIVO en producción (excluye familias del ranking)
# Pausar / modo decorado:
# DISCARD_JUDGE_AUDIT_ONLY=true

# Ola fundacional — etiqueta en casos humanos (opcional)
# NEXT_PUBLIC_FOUNDATIONAL_COHORT_BATCH=foundational_wave_2026_05

# SOLO en .env.local del fundador — explorar barrio sin cuestionario (NO subir a Vercel)
# Ver web/docs/founder-preview-access.md
# NEXT_PUBLIC_VU_FOUNDER_PREVIEW_KEY=
