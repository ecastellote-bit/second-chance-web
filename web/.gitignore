# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# fotos de perfil subidas por usuarios (local / servidor)
/public/uploads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# batch runner reports
/reports/

# surface interest leads (PII — local dev only, never commit)
/data/surface-interest-leads.jsonl
/data/surface-interest-leads*.jsonl

# founder exit feedback (PII — local dev only, never commit)
/data/founder-exit-feedback.jsonl
/data/founder-exit-feedback*.jsonl
